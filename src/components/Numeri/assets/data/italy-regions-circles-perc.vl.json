{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": "container",
  "padding": 5,
  "data": {
    "url": "https://gist.githubusercontent.com/StefanoFrontini/1572aa83bd623e27a7ff35a917872203/raw/ac2333946a6c9d1d78b4c0b35c336ebc1db76e88/sezione2-test.json",
    "format": { "property": "geo_comuni" }
  },
  "params": [{ "name": "year", "value": null }],
  "transform": [
    {
      "filter": "year === year(datum.year) || year === datum.year"
    },
    {
      "lookup": "regione",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/openpolis/geojson-italy/refs/heads/master/topojson/limits_IT_regions.topo.json",
          "format": { "type": "topojson", "feature": "regions" }
        },
        "key": "properties.reg_name",
        "fields": ["type", "properties", "geometry"]
      }
    }
  ],
  "projection": { "type": "mercator" },
  "mark": { "type": "geoshape", "stroke": "#fff", "strokeWidth": 0.5 },
  "encoding": {
    "color": {
      "field": "perc_comuni_attivi",
      "type": "quantitative",
      "scale": {
        "range": ["#b6c5f7", "#0B3EE3"]
      },
      "legend": null
    },
    "tooltip": [
      { "field": "regione", "type": "nominal", "title": "Regione" },
      {
        "field": "num_comuni_attivi",
        "format": ",",
        "type": "quantitative",
        "title": "Comuni"
      },
      {
        "field": "perc_comuni_attivi",
        "format": ".0%",
        "type": "quantitative",
        "title": "Percentuale comuni rispetto al totale dei comuni per regione"
      }
    ]
  }
}
