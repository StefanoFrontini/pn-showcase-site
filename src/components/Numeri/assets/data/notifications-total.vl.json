{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://gist.githubusercontent.com/StefanoFrontini/273f3188acf8bfe7ee2f16fd918e6a03/raw/602ba2a813099dbc47f977b1db997fae14addb41/sezione1-test.json",
    "format": { "property": "totale_notifiche" }
  },
  "params": [{ "name": "year", "value": null }],
  "transform": [{ "filter": "year == datum.year || year === +datum.year" }],
  "mark": "text",
  "encoding": {
    "text": { "field": "num_iun", "aggregate": "sum", "format": ",d" }
  }
}
