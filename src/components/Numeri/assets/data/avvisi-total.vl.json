{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://gist.githubusercontent.com/StefanoFrontini/273f3188acf8bfe7ee2f16fd918e6a03/raw/c9bc7e3280ff14cb24f0767df089fd406015a735/sezione1-test.json",
    "format": { "property": "totale_avvisi" }
  },
  "params": [{ "name": "year", "value": null }],
  "transform": [{ "filter": "year == datum.year || year === +datum.year" }],
  "mark": "text",
  "encoding": {
    "text": { "field": "num_avvisi", "aggregate": "sum", "format": ",d" }
  }
}
