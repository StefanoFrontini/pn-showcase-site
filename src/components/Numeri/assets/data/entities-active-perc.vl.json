{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://gist.githubusercontent.com/StefanoFrontini/1572aa83bd623e27a7ff35a917872203/raw/cc875a749b3a76ba04b2f1edf4d621fec0c44193/sezione2-test.json",
    "format": { "property": "enti_attivi" }
  },
  "params": [{ "name": "year", "value": null }],
  "transform": [
    { "filter": "year === year(datum.year) || year === datum.year" },
    { "filter": "datum.pct_variazione_vs_anno_prec !== null" }
  ],
  "mark": "text",
  "encoding": {
    "text": {
      "field": "pct_variazione_vs_anno_prec",
      "type": "quantitative",
      "format": ".0%"
    }
  }
}
