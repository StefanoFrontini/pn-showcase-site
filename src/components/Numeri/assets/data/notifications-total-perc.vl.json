{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://gist.githubusercontent.com/StefanoFrontini/273f3188acf8bfe7ee2f16fd918e6a03/raw/50eb5bd7a53975f9bab41e2e5f243eb67bf69997/sezione1-test.json",
    "format": { "property": "perc_notifiche" }
  },
  "params": [{ "name": "year", "value": null }],
  "transform": [
    { "filter": "year == datum.year || year === +datum.year" },
    { "filter": "datum.perc_tot_notifiche !== null" }
  ],
  "mark": "text",
  "encoding": {
    "text": {
      "field": "perc_tot_notifiche",
      "type": "quantitative",
      "format": ".0%"
    }
  }
}
