{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 120,
  "height": 116,
  "padding": 25,
  "data": {
    "url": "https://gist.githubusercontent.com/StefanoFrontini/273f3188acf8bfe7ee2f16fd918e6a03/raw/02a8642c21bb4eeb26cd0476826af86a15ee09dd/sezione1-test.json",
    "format": { "property": "totale_avvisi" }
  },
  "params": [{ "name": "year", "value": null }],
  "transform": [
    { "filter": "year == datum.year || year === +datum.year" },
    {
      "calculate": "datum.type_avviso == 'APP_IO' ? 'App IO' : 'Email/SMS'",
      "as": "type"
    },
    {
      "joinaggregate": [{ "op": "sum", "field": "num_avvisi", "as": "total" }]
    },
    { "calculate": "datum.num_avvisi / datum.total", "as": "percentage" }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 65,
        "outerRadius": 110,
        "padAngle": 0.04,
        "cornerRadius": 5
      }
    },
    {
      "mark": {
        "type": "text",
        "radius": 123,
        "fill": "#0B3EE3",
        "fontWeight": "bold",
        "fontSize": 14
      },
      "encoding": {
        "text": { "field": "percentage", "type": "nominal", "format": ".0%" },
        "theta": { "field": "num_avvisi", "type": "quantitative", "stack": true }
      }
    }
  ],
  "encoding": {
    "theta": { "field": "num_avvisi", "type": "quantitative", "stack": true },
    "color": {
      "field": "type",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": ["Email/SMS", "App IO"],
        "range": ["url(#pattern_1)", "url(#pattern_2)"]
      }
    },
    "tooltip": [
      { "field": "type", "type": "nominal", "title": "Canale" },
      { "field": "num_avvisi", "type": "quantitative", "title": "Numero di avvisi", "format": "," }
    ]
  },
  "view": { "stroke": null }
}
